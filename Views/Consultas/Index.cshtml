@model IReadOnlyList<Consulta>
@{ ViewData["Title"] = "Minhas consultas"; }
<div class="page-heading">
    <div><span class="eyebrow">MINHA AGENDA</span><h1>Minhas consultas</h1><p class="muted">Acompanhe e organize seus próximos compromissos.</p></div>
    <a class="button" asp-action="Criar">+ Nova consulta</a>
</div>
@if (Model.Count == 0)
{
    <div class="card empty"><div class="calendar-icon">✦</div><h2>Nenhuma consulta cadastrada</h2><p>Comece adicionando sua primeira consulta.</p><a class="button" asp-action="Criar">Cadastrar consulta</a></div>
}
else
{
    <div class="consultas">
        @foreach (var consulta in Model)
        {
            <article class="card consulta-card">
                <div class="date-box"><strong>@consulta.DataHora.ToString("dd")</strong><span>@consulta.DataHora.ToString("MMM", new System.Globalization.CultureInfo("pt-BR"))</span></div>
                <div class="consulta-info"><h2>@consulta.Especialidade</h2><p class="muted">@consulta.DataHora.ToString("dddd, dd/MM/yyyy 'às' HH:mm", new System.Globalization.CultureInfo("pt-BR"))</p><p>@consulta.Descricao</p></div>
                <div class="card-actions"><a asp-action="Editar" asp-route-id="@consulta.Id">Editar</a><a class="danger-link" asp-action="Excluir" asp-route-id="@consulta.Id">Excluir</a></div>
            </article>
        }
    </div>
}
