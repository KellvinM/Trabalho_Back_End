@model CadastroViewModel
@{ ViewData["Title"] = "Criar conta"; }
<div class="card narrow">
    <span class="eyebrow">PRIMEIRO ACESSO</span>
    <h1>Crie sua conta</h1>
    <p class="muted">Preencha seus dados para começar a gerenciar consultas.</p>
    <form asp-action="Cadastro" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Nome">Nome completo</label>
        <input asp-for="Nome" autocomplete="name" />
        <span asp-validation-for="Nome" class="validation"></span>
        <label asp-for="Email">E-mail</label>
        <input asp-for="Email" autocomplete="email" />
        <span asp-validation-for="Email" class="validation"></span>
        <label asp-for="Senha">Senha</label>
        <input asp-for="Senha" autocomplete="new-password" />
        <span asp-validation-for="Senha" class="validation"></span>
        <label asp-for="ConfirmarSenha">Confirme a senha</label>
        <input asp-for="ConfirmarSenha" autocomplete="new-password" />
        <span asp-validation-for="ConfirmarSenha" class="validation"></span>
        <button class="button full" type="submit">Criar conta</button>
    </form>
    <p class="form-footer">Já possui conta? <a asp-action="Login">Entrar</a></p>
</div>
